# Google Tag Manager Container ID (ex: GTM-XXXXXXX)
VITE_GTM_ID=GTM-P69LMTGG

# Google Analytics 4 Measurement ID (ex: G-XXXXXXXXXX)
VITE_GA_ID=G-R8NQ50ZW99

# Meta (Facebook/Instagram) Pixel ID
VITE_META_PIXEL_ID=1571381581401643

# SMTP password for local development only. Keep this value out of VITE_* variables.
SMTP_PASSWORD=

# Long random key (at least 32 characters) for the private campaign sender.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Configure only as a server-side secret in the hosting provider, never as VITE_*.
EMAIL_CAMPAIGN_ADMIN_KEY=
